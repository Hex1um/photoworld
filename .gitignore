# 训练产物/数据只忽略仓库根目录的 data/，不能误伤 worldmodel/data/ 代码包
/data/
runs/
out/
__pycache__/
*.pyc

# 质检截图（tools/shot.mjs / probe.mjs / orbit_shot.mjs 产物）
/shots/

# 语料与评测产物（本地训练/质检用，不入库：1000+ 张图约 300MB）
/corpus/
/reports/

# 本地 Node 依赖（jpeg-js 用于 tools/eval.mjs 解码，npm i --no-save 安装）
node_modules/
package-lock.json

# v2 管线：深度权重（1.3GB）不进仓库，见 pipeline/v2/README.md
/models/da2_large/

# v2 中间产物：深度缓存 / 烘焙输出（world.glb 每个 10MB 量级）
/cache/
/pipeline/v2/_tmp_out.glb

# 启动器日志与 PID（本机运行时产物）
/logs/
